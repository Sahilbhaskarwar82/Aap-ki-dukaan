# Server Configuration
PORT=8000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017

# Authentication & Security
JWT_SECRET=supersecretjwtkeyforlocaldevelopmentonlychangeinprod_min32chars
JWT_EXPIRY=7d
ACCESS_TOKEN_SECRET=supersecretjwtkeyforlocaldevelopmentonlychangeinprod_min32chars
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=supersecretjwtkeyforlocaldevelopmentonlychangeinprod_min32chars
REFRESH_TOKEN_EXPIRY=10d

# Group-Buy & Two-Level MOQ Lifecycle Defaults
POOL_DURATION_HOURS=72
UNDER_MOQ_DECISION_HOURS=24
DEFAULT_RETAILER_MOQ_PERCENT=20
DEFAULT_RETAILER_STEP_PERCENT=1

# FinTech / PayPal Sandbox
PAYMENT_MODE=mock
PAYPAL_CLIENT_ID=mock_paypal_client_id
PAYPAL_CLIENT_SECRET=mock_paypal_client_secret
PAYPAL_WEBHOOK_ID=mock_paypal_webhook_id

# Redis & Background Email Delivery (Nagrik Setu / Upstash & Resend)
REDIS_URL=rediss://default:your_redis_password@your_redis_host:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=CoBuy AI <auth@prakkkkhar.tech>

# Storage & AI
MAX_UPLOAD_SIZE_MB=10
AI_API_KEY=mock_ai_api_key
AI_PROVIDER=mock
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=15000
