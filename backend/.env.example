# Server Configuration
PORT=8000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017

# Authentication & Security
JWT_SECRET=supersecretjwtkeyforlocaldevelopmentonlychangeinprod_min32chars
JWT_EXPIRY=7d

# Group-Buy & Two-Level MOQ Lifecycle Defaults
POOL_DURATION_HOURS=72
UNDER_MOQ_DECISION_HOURS=24
DEFAULT_RETAILER_MOQ_PERCENT=20
DEFAULT_RETAILER_STEP_PERCENT=1

# FinTech / PayPal Sandbox
PAYMENT_MODE=mock
PAYPAL_CLIENT_ID=mock_paypal_client_id
PAYPAL_CLIENT_SECRET=mock_paypal_client_secret
PAYPAL_WEBHOOK_ID=mock_paypal_webhook_id

# Storage & AI
MAX_UPLOAD_SIZE_MB=10
AI_API_KEY=mock_ai_api_key

